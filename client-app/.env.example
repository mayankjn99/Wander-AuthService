# ─── Auth Server ──────────────────────────────────────────────────────────────
AUTH_SERVER_URL=http://localhost:3000

# ─── OAuth Client Credentials ─────────────────────────────────────────────────
# Must match CLIENT_ID / CLIENT_SECRET in the auth-server .env
CLIENT_ID=client-app-1
CLIENT_SECRET=mysecret123

# The exact URI the auth server will redirect back to after login
# Must be in auth-server ALLOWED_REDIRECT_URIS list
REDIRECT_URI=http://localhost:3001/callback

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=647c8227d789c3be4f901207f3ebf4cab774ea65d1a22484901301afcb72cb9ff95058d3081f75cfc822b5be6ed8d5463a35f42ce718199a2404ec349cfd7a45

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
