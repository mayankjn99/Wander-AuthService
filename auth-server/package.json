{
  "name": "auth-server",
  "version": "1.0.0",
  "description": "Centralized OAuth 2.0 Identity Provider — Authorization Code Flow",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "overrides": {
    "@mongodb-js/saslprep": "1.1.7",
    "is-core-module": "2.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
