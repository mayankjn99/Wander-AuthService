# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/auth-server
# Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/auth-server
MONGO_URI=mongodb://127.0.0.1:27017/auth-server

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=15e76814f0643803af9b6d29b171dc19f48b40288ddd7eb8270a5b2b91cbf0df002e9031dc840ebd3ffdce83683956bab693118fce9ca4063f34dce9f166b41b
SESSION_SECRET=844709bf43254e9700a6925647cd4561838a224daea30ec878577f83b89c106c0e24003deb842b8ed7d379a4e736b259b41894ac852f4562a81c76b0d5a1baac

# ─── OAuth Client Registry ────────────────────────────────────────────────────
# The ID and secret the Client App will use to authenticate itself
CLIENT_ID=client-app-1
CLIENT_SECRET=mysecret123

# Comma-separated list of ALLOWED redirect URIs (must match exactly)
# Whitelist ONLY your known callback URLs — prevents Open Redirect attacks
ALLOWED_REDIRECT_URIS=http://localhost:3001/callback

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origins allowed to POST to /oauth/token (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
